{
  "name": "proqueue",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "proqueue",
      "workspaces": [
        "packages/*",
        "apps/*"
      ]
    },
    "apps/client": {},
    "apps/server": {},
    "node_modules/@proqueue/analytics": {
      "resolved": "packages/analytics",
      "link": true
    },
    "node_modules/@proqueue/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "node_modules/client": {
      "resolved": "apps/client",
      "link": true
    },
    "node_modules/server": {
      "resolved": "apps/server",
      "link": true
    },
    "packages/analytics": {
      "name": "@proqueue/analytics",
      "version": "1.0.0",
      "dependencies": {
        "@proqueue/shared": "*"
      }
    },
    "packages/shared": {
      "name": "@proqueue/shared",
      "version": "1.0.0"
    }
  }
}

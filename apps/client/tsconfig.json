{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "@proqueue/shared/*": [
        "../../packages/shared/*"
      ],
      "@proqueue/analytics/*": [
        "../../packages/analytics/*"
      ]
    }
  },
  "include": [
    "src/**/*",
    "../../packages/shared/**/*"
  ],
  "references": [
    {
      "path": "../../packages/shared"
    }
  ]
}
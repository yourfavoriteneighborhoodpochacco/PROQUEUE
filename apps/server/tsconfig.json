{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "@proqueue/shared/*": [
        "../../packages/shared/*"
      ],
      "@proqueue/analytics/*": [
        "../../packages/analytics/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "references": [
    {
      "path": "../../packages/shared"
    },
    {
      "path": "../../packages/analytics"
    }
  ],
  "exclude": [
    "dist",
    "**/dist",
    "**/__tests__",
    "**/*.test.ts"
  ]
}
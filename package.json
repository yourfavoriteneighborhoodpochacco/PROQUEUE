{
  "name": "proqueue",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=apps/server",
    "dev:client": "npm run dev --workspace=apps/client",
    "build": "npm run build -w @proqueue/shared && npm run build -w @proqueue/analytics && npm run build -w @proqueue/server",
    "test": "npm run test --workspaces"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "tsx": "^4.22.2"
  }
}

{
  "name": "@proqueue/shared",
  "version": "1.0.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./types/*": {
      "require": "./dist/types/*.js",
      "types": "./dist/types/*.d.ts"
    },
    "./enums/*": {
      "require": "./dist/enums/*.js",
      "types": "./dist/enums/*.d.ts"
    },
    "./constants/*": {
      "require": "./dist/constants/*.js",
      "types": "./dist/constants/*.d.ts"
    }
  }
}
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "./dist",
    "declarationDir": "./dist"
  },
  "include": [
    "types/**/*",
    "enums/**/*",
    "constants/**/*"
  ],
  "exclude": [
  "dist",
  "**/dist",
  "**/__tests__",
  "**/*.test.ts"
]
}
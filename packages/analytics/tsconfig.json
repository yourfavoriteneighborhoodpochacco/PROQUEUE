{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "./dist",
    "declarationDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@proqueue/shared/*": ["../shared/*"]
    }
  },
  "include": [
    "parsing/**/*",
    "detection/**/*",
    "scoring/**/*",
    "profiling/**/*",
    "__tests__/**/*"
  ],
  "references": [
    { "path": "../shared" }
  ]
}
{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "./dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@proqueue/shared/*": ["../shared/*"]
    },
    "composite": true
  },
  "include": [
    "parsing/**/*",
    "detection/**/*",
    "scoring/**/*",
    "profiling/**/*"
  ],
  "references": [
    { "path": "../shared" }
  ],
  "exclude": ["dist", "node_modules"]
}